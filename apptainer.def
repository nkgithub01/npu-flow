Bootstrap: docker
From: ubuntu:24.04

%files
    # Copy the current directory to /workspace inside the container
    . /workspace

%post
    # --- 1. System Setup ---
    export DEBIAN_FRONTEND=noninteractive
    
    # Update apt and install required packages
    apt-get update && apt-get install -y \
        build-essential \
        cmake \
        python3 \
        python3-pip \
        catch2 \
        git \
        ca-certificates \
        wget \
        sudo

    # Switch to workspace for the rest of the installation
    cd /workspace

    # Make scripts executable
    chmod +x .github/scripts/install_ci_xrt.sh \
        && chmod +x .github/scripts/install_mlir_aie.sh \
        && chmod +x .github/scripts/install_or_tools.sh

    # --- 2. Install XRT ---
    bash -c "source .github/scripts/install_ci_xrt.sh"

    # --- 3. Install MLIR-AIE ---
    bash -c "source .github/scripts/install_mlir_aie.sh"

    # Define MLIR variables for the CURRENT build session (required for next steps)
    export MLIR_AIE_DIR=/workspace/mlir-aie
    export MLIR_AIE_INSTALL_DIR=$MLIR_AIE_DIR/install
    export PEANO_INSTALL_DIR=$MLIR_AIE_DIR/ironenv/lib/python3.12/site-packages/llvm-aie
    export PATH=$MLIR_AIE_INSTALL_DIR/bin:$PATH
    export PYTHONPATH=$MLIR_AIE_INSTALL_DIR/python
    export LD_LIBRARY_PATH=$MLIR_AIE_INSTALL_DIR/lib
    export PEANO_CLANG=$PEANO_INSTALL_DIR/bin/clang++
    export NPU2=1

    # --- 4. Install OR-Tools ---
    bash -c "source .github/scripts/install_or_tools.sh 24.04"
    
    # Define OR-Tools variables for the CURRENT build session
    export OR_TOOLS_DIR=/workspace/or-tools
    export LD_LIBRARY_PATH=$OR_TOOLS_DIR/lib:$LD_LIBRARY_PATH
    export CPATH=$OR_TOOLS_DIR/include
    export PATH=$OR_TOOLS_DIR/bin:$PATH

    # --- 5. Install PnR Tool ---
    export NPU_PNR_BUILD_DIR=/workspace/npu-pnr/build
    export NPU_PNR_BIN_DIR=$NPU_PNR_BUILD_DIR/apps
    
    mkdir -p $NPU_PNR_BUILD_DIR
    cd $NPU_PNR_BUILD_DIR
    cmake .. -DCMAKE_PREFIX_PATH=$OR_TOOLS_DIR -DCMAKE_BUILD_TYPE=Release
    make -j$(nproc)
    make test

%environment
    # --- Runtime Environment Variables ---
    
    # 1. Add IronEnv (Venv) to PATH for 'apptainer exec' support
    export PATH=/workspace/mlir-aie/ironenv/bin:$PATH

    # 2. MLIR-AIE variables
    export MLIR_AIE_DIR=/workspace/mlir-aie
    export MLIR_AIE_INSTALL_DIR=$MLIR_AIE_DIR/install
    export PEANO_INSTALL_DIR=$MLIR_AIE_DIR/ironenv/lib/python3.12/site-packages/llvm-aie
    
    export PATH=$MLIR_AIE_INSTALL_DIR/bin:$PATH
    export PYTHONPATH=$MLIR_AIE_INSTALL_DIR/python
    export LD_LIBRARY_PATH=$MLIR_AIE_INSTALL_DIR/lib
    
    export PEANO_CLANG=$PEANO_INSTALL_DIR/bin/clang++
    export NPU2=1

    # 3. OR-Tools variables
    export OR_TOOLS_DIR=/workspace/or-tools
    export LD_LIBRARY_PATH=$OR_TOOLS_DIR/lib:$LD_LIBRARY_PATH
    export CPATH=$OR_TOOLS_DIR/include
    export PATH=$OR_TOOLS_DIR/bin:$PATH

    # 4. PnR Tool variables
    export NPU_PNR_BUILD_DIR=/workspace/npu-pnr/build
    export NPU_PNR_BIN_DIR=$NPU_PNR_BUILD_DIR/apps
    export PATH=$NPU_PNR_BUILD_DIR:$PATH
    
%runscript
    #!/bin/bash
    # --- 1. SETUP ENVIRONMENT ---

    # Source the Python Virtual Environment
    . /workspace/mlir-aie/ironenv/bin/activate

    # Source XRT setup
    . /opt/xilinx/xrt/setup.sh
    
    # --- 2. EXECUTE USER COMMAND ---

    if [ $# -gt 0 ]; then
        # If args provided (e.g. 'apptainer run my.sif python3 main.py'), run them
        exec "$@"
    else
        # If no args provided (e.g. 'apptainer run my.sif'), open bash
        exec /bin/bash
    fi

%labels
    Author James Yen
    Version 1.0
    Description Ubuntu 24.04 with MLIR-AIE, XRT, and OR-Tools