MLIR_AIE_DIR ?= $(realpath ../../mlir-aie)
AIEOPT_DIR ?= ${MLIR_AIE_DIR}/build

AIE_KERNELS_DIR = ${MLIR_AIE_DIR}/aie_kernels/aie2
AIE_PARSE_TRACE_DIR = ${MLIR_AIE_DIR}/programming_examples/utils

# Add npu-flow/utils to python path
PYTHONPATH := $(realpath ../../utils):$(PYTHONPATH)
export PYTHONPATH

WARNING_FLAGS = -Wno-parentheses -Wno-attributes -Wno-macro-redefined -Wno-empty-body
PEANOWRAP2P_FLAGS = -O2 -std=c++20 --target=aie2p-none-unknown-elf ${WARNING_FLAGS} -DNDEBUG \
  -I ${AIEOPT_DIR}/include \
  -I ${MLIR_AIE_DIR}/include
